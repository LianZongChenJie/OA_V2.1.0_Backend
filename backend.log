CREATE TABLE oa_project_monthly (
	id INTEGER NOT NULL COMMENT '主键ID' AUTO_INCREMENT, 
	stat_month CHAR(7) NOT NULL COMMENT '年度/统计月份 YYYY-MM' DEFAULT '''''', 
	customer_name VARCHAR(255) NOT NULL COMMENT '客户名称' DEFAULT '''''', 
	project_name VARCHAR(255) NOT NULL COMMENT '项目名称' DEFAULT '''''', 
	contract_signed SMALLINT NOT NULL COMMENT '合同是否签订：0否 1是' DEFAULT '0', 
	planned_cost DECIMAL(15, 2) NOT NULL COMMENT '预计投入成本' DEFAULT '0.00', 
	actual_cost DECIMAL(15, 2) NOT NULL COMMENT '实际投入成本' DEFAULT '0.00', 
	planned_profit DECIMAL(15, 2) NOT NULL COMMENT '预计项目利润' DEFAULT '0.00', 
	actual_profit DECIMAL(15, 2) NOT NULL COMMENT '实际项目利润' DEFAULT '0.00', 
	collection_agreement VARCHAR(500) NOT NULL COMMENT '合同收款约定' DEFAULT '''''', 
	invoiced_amount DECIMAL(15, 2) NOT NULL COMMENT '实际开票金额' DEFAULT '0.00', 
	received_amount DECIMAL(15, 2) NOT NULL COMMENT '实际收款金额' DEFAULT '0.00', 
	project_closed SMALLINT NOT NULL COMMENT '是否结项：0否 1是' DEFAULT '0', 
	project_id INTEGER NOT NULL COMMENT '关联旧项目ID（可选）' DEFAULT '0', 
	remark VARCHAR(1000) NOT NULL COMMENT '备注' DEFAULT '''''', 
	admin_id INTEGER NOT NULL COMMENT '创建人' DEFAULT '0', 
	create_time BIGINT NOT NULL COMMENT '创建/上传/新增时间' DEFAULT '0', 
	update_time BIGINT NOT NULL COMMENT '更新时间' DEFAULT '0', 
	delete_time BIGINT NOT NULL COMMENT '删除时间' DEFAULT '0', 
	tenant_id BIGINT NOT NULL COMMENT '租户ID' DEFAULT '1', 
	PRIMARY KEY (id)
)COMMENT='项目月度台账表'


